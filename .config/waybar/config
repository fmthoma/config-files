{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": ["tray", "clock"],
    "niri/workspaces": {
        "format": "{name}"
    },
    "niri/window": {
        "format": "{title}"
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}"
    }
}
