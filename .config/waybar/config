{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": ["tray", "pulseaudio", "pulseaudio#mic", "network", "battery", "clock", "custom/power"],
    "niri/workspaces": {
        "format": "{name}"
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 100
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}"
    },
    "battery": {
        "interval": 10,
        "format": "{capacity}% {icon}",
        "format-icons": [
            "\uf244",
            "\uf243",
            "\uf242",
            "\uf241",
            "\uf240"
        ],
        "states": {
            "warning": 40,
            "critical": 20
        },
        "tooltip-format": "{timeTo}"
    },
    "network": {
        "interval": 5,
        "format-wifi": "<span foreground='#6c71c4'></span> {essid}",
        "format-ethernet": "<span foreground='#6c71c4'></span> {ifname}",
        "format-disconnected": "<span foreground='#dc322f'></span> offline",
        "tooltip-format-wifi": "{essid} ({signal}%)",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "<span foreground='#cb4b16'></span> {volume}%",
        "format-muted": " MUTE ",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "pulseaudio#mic": {
        "target": "source",
        "format": "<span foreground='#cb4b16'></span> {volume}%",
        "format-muted": " MUTE ",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },
    "tray": {
        "icon-size": 18
    },
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
