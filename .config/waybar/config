{
    "layer": "top",
    "position": "bottom",
    "height": 40,
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "pulseaudio#spk",
        "pulseaudio#mic",
        "group/network",
        "backlight",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],

    "niri/workspaces": {
        "format": "{name}",
        "hide-empty": true
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 100
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}"
    },
    "battery": {
        "interval": 10,
        "format": "{capacity}% {icon} {time}",
        "format-full": "\uf1e6",
        "format-plugged": "\uf1e6",
        "format-charging": "{capacity}% \uf0e7 {time}",
        "format-time": "{H}:{m}",
        "format-icons": [
            "\uf244",
            "\uf243",
            "\uf242",
            "\uf241",
            "\uf240"
        ],
        "design-capacity": true,
        "states": {
            "warning": 40,
            "critical": 20
        },
        "tooltip-format": "{capacity}% • {power}W • {timeTo} • {health}% health"
    },
    "group/network": {
        "orientation": "horizontal",
        "modules": [
            "network#wifi",
            "network#eth",
            "network#vpn"
        ]
    },
    "network#wifi": {
        "interval": 5,
        "interface": "wlp0s2*",
        "format": "\uf1eb {essid}",
        "format-disconnected": "\uf1eb —",
        "tooltip-format-wifi": "{essid} ({signal}%)",
        "on-click": "nm-connection-editor"
    },
    "network#eth": {
        "interval": 5,
        "interface": "enp0s2*",
        "format": "\uf0e8",
        "format-disconnected": "",
        "tooltip-format": "{ifname}",
        "on-click": "nm-connection-editor"
    },
    "network#vpn": {
        "interval": 5,
        "interface": "tun0",
        "format": "\uf13e",
        "tooltip-format": "{ifname}",
        "format-disconnected": ""
    },
    "pulseaudio#spk": {
        "format": "\uf028 {volume}%",
        "format-muted": "\uf467 MUTE",
        "align": 0,
        "on-click": "pavucontrol"
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "\uf130 {volume}%",
        "format-source-muted": "\uf131 MUTE",
        "min-length": 7,
        "align": 0,
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["\uf185"],
        "min-brightness": 1
    },
    "tray": {
        "icon-size": 16
    },
    "custom/power": {
        "format" : "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
