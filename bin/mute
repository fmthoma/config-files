#!/usr/bin/env bash

is_muted() {
  wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q "MUTED"
}

case "${1:-on}" in
  on)
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1
    ;;
  off)
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
    ;;
  toggle)
    if is_muted; then
      "$0" off
    else
      "$0" on
    fi
    ;;
esac
